{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ascendant-empire-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "AscendantEmpireDatabase": "Server=CoreOS\\SQLExpress;Database=AscendantEmpire;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AscendantEmpire.Api",
    "Audience": "AscendantEmpire.Client",
    "AccessTokenMinutes": 5,
    "RefreshTokenDays": 14,
    "_SigningKey_comment": "Do NOT put the real signing key here. Set it via user-secrets: dotnet user-secrets set \"Jwt:SigningKey\" \"<a long random secret>\". A dev placeholder lives in appsettings.Development.json."
  },
  "ExportSettings": {
    "TempDirectory": "P:\\Development\\AscendantEmpire_Files\\Exports"
  },
  "MapGenerationSettings": {
    "OutputDirectory": "P:\\Development\\AscendantEmpire_Files\\MapPreviews"
  },
  "BackgroundProcessingSettings": {
    "ChannelCapacity": 50
  }
}
