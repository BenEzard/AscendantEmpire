{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ascendant-empire-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "AscendantEmpireDatabase": "Server=CoreOS\\SQLExpress;Database=AscendantEmpire;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "ExportSettings": {
    "TempDirectory": "P:\\Development\\AscendantEmpire_Exports"
  },
  "MapGenerationSettings": {
    "OutputDirectory": "P:\\Development\\AscendantEmpire_MapPreviews"
  },
  "BackgroundProcessingSettings": {
    "ChannelCapacity": 50
  }
}
